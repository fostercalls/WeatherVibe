# WeatherVibe Environment Variables

# Optional: Override default API endpoints
# VITE_WEATHER_API_URL=https://api.open-meteo.com/v1
# VITE_GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1

# Optional: Default location (if geolocation fails)
# VITE_DEFAULT_LATITUDE=40.7128
# VITE_DEFAULT_LONGITUDE=-74.0060
# VITE_DEFAULT_CITY=New York

# Optional: Cache settings (in minutes)
# VITE_CACHE_DURATION=10
# VITE_AUTO_REFRESH_INTERVAL=10